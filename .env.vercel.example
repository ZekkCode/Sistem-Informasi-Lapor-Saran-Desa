APP_NAME="Sistem Lapor Padelegan"
APP_ENV=production
APP_KEY=base64:GANTI_DENGAN_HASIL_PHP_ARTISAN_KEY_GENERATE_SHOW
APP_DEBUG=false
APP_URL=https://nama-project.vercel.app
SITE_SUPPORT_EMAIL=

# Kontak bantuan situs untuk warga (tampil di halaman Bantuan).
SITE_SUPPORT_CONTACT_NAME="Pak Wakil Sekdes"
SITE_SUPPORT_WHATSAPP=6282301842301
SITE_SUPPORT_WHATSAPP_LABEL="+62 823-0184-2301"
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_MAINTENANCE_DRIVER=cache

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Supabase (PostgreSQL terkelola). SQLite tidak persisten di Vercel.
# Laravel memakai koneksi PostgreSQL langsung, bukan REST API, jadi
# publishable key dan secret key Supabase tidak perlu diisi di mana pun.
# Ambil dari Supabase: Connect > Session pooler (port 5432). Jangan pakai
# Transaction pooler port 6543, mode itu membuat query boolean Laravel gagal.
# Salin host dari dialog Connect (awalan aws-0 atau aws-1), ganti PASSWORD
# dengan password database, dan encode karakter khusus (@ jadi %40, # jadi %23).
# Cukup isi DB_URL. Koneksi otomatis memakai pgsql bila URL diawali postgres.
DB_URL=postgresql://postgres.wgadkdgapbvxcqojfbqb:PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=require

# Cookie/array membuat halaman pratinjau tetap hidup saat database belum siap.
# Setelah database stabil, keduanya boleh diganti menjadi database.
SESSION_DRIVER=cookie
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=array

# Vercel tidak menjalankan queue worker persisten. Job cadangan berjalan sesudah respons.
QUEUE_CONNECTION=sync

# Cloudflare R2 / penyimpanan kompatibel S3.
# Cukup isi kredensial R2 di bawah. Begitu AWS_BUCKET terisi, disk utama dan
# unggah langsung aktif otomatis, jadi baris REPORT_* bersifat opsional.
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Opsional: timpa deteksi otomatis media bila perlu.
# REPORT_MEDIA_DISK=s3
# REPORT_DIRECT_UPLOAD=true
# REPORT_DIRECT_UPLOAD_REQUIRED=true
# REPORT_DIRECT_UPLOAD_DISK=s3

# Cadangan Google Drive opsional.
GOOGLE_DRIVE_BACKUP_ENABLED=false
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_BACKUP_QUEUE=backups

# Masuk petugas dengan Google. Buat OAuth client di Google Cloud Console
# (jenis Web application) dan daftarkan redirect URI:
# https://DOMAIN-ANDA/admin/login/google/callback
# Akun Google resmi desa sudah menjadi nilai bawaan. Saat pertama kali masuk,
# akun petugas dibuat otomatis dengan peran Admin Desa (GOOGLE_SSO_ROLE=admin).
# Email di luar daftar ditolak dengan popup "Akun ini bukan akun admin desa".
GOOGLE_SSO_CLIENT_ID=
GOOGLE_SSO_CLIENT_SECRET=
GOOGLE_SSO_REDIRECT_URI=
GOOGLE_SSO_ALLOWED_EMAILS=laporpadelegan@gmail.com
GOOGLE_SSO_ROLE=admin

# Kredensial akun petugas untuk DEMO ke buyer.
# Isi nilai di bawah, jalankan `php artisan db:seed --force` sekali setelah
# database tersambung, lalu akun langsung bisa dipakai login di /admin/login.
# Ganti password setelah demo, lalu kosongkan kembali nilainya.
INITIAL_ADMIN_NAME="Administrator Desa"
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD="Padelegan#Demo2026"

INITIAL_ADMIN_DESA_NAME="Admin Desa Padelegan"
INITIAL_ADMIN_DESA_USERNAME=admindesa
# Menautkan akun admindesa ke akun Google resmi agar username dan Google
# membuka akun yang sama. Boleh dikosongkan, SSO tetap membuat akun sendiri.
INITIAL_ADMIN_DESA_EMAIL=laporpadelegan@gmail.com
INITIAL_ADMIN_DESA_PASSWORD="AdminDesa#Demo2026"
