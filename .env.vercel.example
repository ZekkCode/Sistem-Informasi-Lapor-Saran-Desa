APP_NAME="Sistem Lapor Padelegan"
APP_ENV=production
APP_KEY=base64:GANTI_DENGAN_HASIL_PHP_ARTISAN_KEY_GENERATE_SHOW
APP_DEBUG=false
APP_URL=https://nama-project.vercel.app
SITE_SUPPORT_EMAIL=
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_MAINTENANCE_DRIVER=cache

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Gunakan MySQL/PostgreSQL terkelola. SQLite tidak persisten di Vercel.
DB_CONNECTION=pgsql
DB_URL=postgresql://user:password@host/database?sslmode=require

# Cookie/array membuat halaman pratinjau tetap hidup saat database belum siap.
# Setelah database stabil, keduanya boleh diganti menjadi database.
SESSION_DRIVER=cookie
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=array

# Vercel tidak menjalankan queue worker persisten. Job cadangan berjalan sesudah respons.
QUEUE_CONNECTION=sync

# Cloudflare R2 / penyimpanan kompatibel S3.
FILESYSTEM_DISK=s3
REPORT_MEDIA_DISK=s3
REPORT_DIRECT_UPLOAD=true
REPORT_DIRECT_UPLOAD_REQUIRED=true
REPORT_DIRECT_UPLOAD_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Cadangan Google Drive opsional.
GOOGLE_DRIVE_BACKUP_ENABLED=false
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_BACKUP_QUEUE=backups

INITIAL_ADMIN_NAME="Administrator Desa"
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=
